node_modules/
dist/
release/
*.log
tmp/

# Toybox source data and artwork cache. Third-party metadata and publisher-owned
# character art, pulled locally for a private build - never committed, because this
# repository is public.
/toybox-data/

# Python bytecode from the NFC / TTS helpers
__pycache__/
*.pyc

# PS3 disc keys: the owner's private collection, packaged into local builds, never committed
/keys/

# Android companion build output
/companion-android/.gradle/
/companion-android/build/
/companion-android/app/build/
/companion-android/local.properties

# Real API keys and service logins. The example file is committed; this one is not.
# This repository is public, so a key in a tracked file is a published key.
/apis/apis.json

# Channel logos the user supplies. Broadcaster marks belong to their owners and
# are not ours to redistribute, so only the README here is tracked.
/network logos/*
!/network logos/README.md
