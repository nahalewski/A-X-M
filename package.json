{
  "name": "axm",
  "productName": "A-X-M",
  "version": "0.2.0-beta.1",
  "description": "Ally XMB Menu - PS3-style game hub for ROG Xbox Ally",
  "main": "dist/main/main.js",
  "private": true,
  "scripts": {
    "build:main": "esbuild src/main/main.ts --bundle --platform=node --target=node22 --external:electron --outdir=dist/main --format=cjs && esbuild src/preload/preload.ts --bundle --platform=node --target=node22 --external:electron --outdir=dist/main --format=cjs",
    "build:renderer": "esbuild src/renderer/main.ts --bundle --platform=browser --outdir=dist/renderer --format=iife",
    "copy:assets": "node scripts/copy-assets.js",
    "build": "npm run build:main && npm run build:renderer && npm run copy:assets",
    "start": "npm run build && electron .",
    "dev": "npm run build && electron . --dev",
    "package": "npm run build && electron-builder"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/three": "^0.171.0",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.2",
    "typescript": "^5.7.2"
  },
  "build": {
    "appId": "com.axm.launcher",
    "productName": "A-X-M",
    "files": [
      "dist/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icons/app.ico"
    },
    "directories": {
      "output": "release"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "A-X-M",
      "artifactName": "A-X-M-Setup-${version}.${ext}",
      "runAfterFinish": true
    },
    "portable": {
      "artifactName": "A-X-M-${version}-portable.${ext}"
    }
  },
  "dependencies": {
    "hls.js": "^1.7.3",
    "music-metadata": "^7.14.0",
    "three": "^0.171.0"
  },
  "author": "nahalewski"
}
