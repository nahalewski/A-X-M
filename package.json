{
  "name": "axm",
  "productName": "A-X-M",
  "version": "0.6.1-beta.1",
  "description": "Ally XMB Menu - PS3-style game hub for ROG Xbox Ally",
  "main": "dist/main/main.js",
  "private": true,
  "scripts": {
    "build:main": "esbuild src/main/main.ts --bundle --platform=node --target=node22 --external:electron --outdir=dist/main --format=cjs && esbuild src/preload/preload.ts --bundle --platform=node --target=node22 --external:electron --outdir=dist/main --format=cjs && esbuild src/voice/voicePreload.ts --bundle --platform=node --target=node22 --external:electron --outfile=dist/main/voicePreload.js --format=cjs",
    "build:renderer": "esbuild src/renderer/main.ts --bundle --platform=browser --outdir=dist/renderer --format=iife && esbuild src/renderer/voiceHost.ts --bundle --platform=browser --outfile=dist/renderer/voice/voice.js --format=iife",
    "copy:assets": "node scripts/copy-assets.js",
    "build": "npm run build:main && npm run build:renderer && npm run copy:assets",
    "start": "npm run build && electron .",
    "dev": "npm run build && electron . --dev",
    "package": "npm run build && electron-builder",
    "package:deck": "npm run build && electron-builder --linux AppImage --x64"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/three": "^0.171.0",
    "@types/ws": "^8.18.1",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.2",
    "typescript": "^5.7.2"
  },
  "build": {
    "appId": "com.axm.launcher",
    "productName": "A-X-M",
    "files": [
      "dist/**/*",
      "assets/**/*",
      "keys/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icons/app.ico"
    },
    "directories": {
      "output": "release"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "A-X-M",
      "artifactName": "A-X-M-Setup-${version}.${ext}",
      "runAfterFinish": true
    },
    "portable": {
      "artifactName": "A-X-M-${version}-portable.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Game",
      "icon": "assets/icons/app.png",
      "artifactName": "A-X-M-${version}-steamdeck-x64.${ext}",
      "desktop": {
        "Name": "A-X-M",
        "Comment": "PS3-XMB-style game hub",
        "Categories": "Game;"
      }
    }
  },
  "dependencies": {
    "hls.js": "^1.7.3",
    "music-metadata": "^7.14.0",
    "three": "^0.171.0",
    "vosk-browser": "^0.0.8",
    "ws": "^8.21.3"
  },
  "author": "nahalewski"
}
